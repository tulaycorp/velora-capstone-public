VELORA_VERBOSE_LOGGING=false
VELORA_ENVIRONMENT=development
VELORA_LOG_FORMAT=pretty
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Frontend env only. Storage uploads are configured in backend/.env via VELORA_STORAGE_*.
VELORA_API_BASE_URL=http://127.0.0.1:8000
# Keep this equal to backend VELORA_UPLOAD_MAX_REQUEST_BYTES for early BFF rejection.
VELORA_UPLOAD_MAX_REQUEST_BYTES=11000000
