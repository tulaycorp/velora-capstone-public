VELORA_VERBOSE_LOGGING=false
VELORA_LOG_LEVEL=INFO
VELORA_LOG_FORMAT=pretty
VELORA_DATABASE_URL=replace-me
VELORA_WORKER_DATABASE_URL=
VELORA_DATABASE_MIGRATION_URL=
VELORA_DATABASE_RUNTIME_ROLE=velora_runtime
# Keep each process pool bounded; use a direct Neon URL for local development.
VELORA_DATABASE_POOL_SIZE=3
VELORA_DATABASE_MAX_OVERFLOW=0
VELORA_DATABASE_POOL_TIMEOUT_SECONDS=10
VELORA_DATABASE_POOL_RECYCLE_SECONDS=300
# Close this process's checked-in connections periodically; 0 disables the purge.
VELORA_DATABASE_IDLE_POOL_PURGE_SECONDS=300
VELORA_NEON_PROJECT_ID=replace-me
REDIS_URL=redis://replace-me:6379/0
VELORA_SYNC_JOB_LEASE_SECONDS=1800
VELORA_SYNC_JOB_MAX_ATTEMPTS=3
VELORA_SYNC_JOB_REAPER_BATCH_SIZE=100
VELORA_ANALYTICS_SNAPSHOT_TTL_SECONDS=1800
VELORA_ORDER_SYNC_PAGE_SIZE=50
VELORA_ORDER_SYNC_MAX_PAGES_PER_CONNECTION=100
VELORA_ORDER_SYNC_OVERLAP_HOURS=24
VELORA_ORDER_SYNC_DETAIL_CONCURRENCY=5
VELORA_COMMERCE_SYNC_INTERVAL_SECONDS=18000
VELORA_EXCHANGE_RATE_API_BASE_URL=https://api.frankfurter.dev
VELORA_EXCHANGE_RATE_API_TIMEOUT_SECONDS=30
VELORA_AUTH_MODE=auto
VELORA_CLERK_JWKS_URL=https://replace-me.clerk.accounts.dev/.well-known/jwks.json
VELORA_CLERK_ISSUER=https://replace-me.clerk.accounts.dev
VELORA_CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000
VELORA_SECRET_ENCRYPTION_KEY=replace-me
# Use a managed secret JSON object for decrypt-only keys during rotation, for example {"v1":"..."}.
VELORA_SECRET_ENCRYPTION_ACTIVE_KEY_ID=v1
VELORA_SECRET_ENCRYPTION_PREVIOUS_KEYS={}
CLERK_SECRET_KEY=sk_test_replace_me
VELORA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
VELORA_API_BASE_URL=http://127.0.0.1:8000

# S3-compatible storage for design assets and mockups.
VELORA_STORAGE_ENDPOINT_URL=https://replace-me-storage-endpoint
VELORA_STORAGE_ACCESS_KEY_ID=replace-me
VELORA_STORAGE_SECRET_ACCESS_KEY=replace-me
VELORA_STORAGE_BUCKET_NAME=replace-me
VELORA_STORAGE_REGION_NAME=us-east-1
VELORA_STORAGE_PRESIGN_GET_TTL_SECONDS=3600
VELORA_STORAGE_ORPHAN_MIN_AGE_SECONDS=3600
VELORA_UPLOAD_MAX_FILE_BYTES=99614720
VELORA_UPLOAD_MAX_REQUEST_BYTES=104857600
VELORA_UPLOAD_SPOOL_MEMORY_BYTES=1000000
VELORA_UPLOAD_MAX_MOCKUPS_PER_PRODUCT=10

# Disabled unless a staging-verified, image/structured-output capable model is configured.
VELORA_AI_PROVIDER=disabled
VELORA_OPENROUTER_API_KEY=replace-me
VELORA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VELORA_OPENROUTER_MODEL=qwen/qwen3-vl-8b-instruct
VELORA_OPENROUTER_APP_URL=https://replace-me.example
VELORA_OPENROUTER_APP_TITLE=Velora
VELORA_OPENROUTER_TIMEOUT_SECONDS=45
VELORA_OPENROUTER_MAX_OUTPUT_TOKENS=2400
VELORA_OPENROUTER_MAX_RETRY_ATTEMPTS=2
VELORA_AI_MAX_SOURCE_IMAGE_BYTES=99614720
VELORA_AI_MAX_IMAGE_BYTES=5000000
VELORA_AI_MAX_IMAGE_DIMENSION=2048
VELORA_AI_MAX_SOURCE_IMAGE_PIXELS=300000000
VELORA_AI_MAX_FULL_DECODE_PIXELS=50000000
VELORA_AI_GENERATION_LIMIT_PER_HOUR=20
VELORA_AI_GENERATION_LIMIT_PER_USER_PER_HOUR=10
VELORA_AI_GENERATION_BURST_LIMIT=3
VELORA_AI_GENERATION_BURST_WINDOW_SECONDS=60
VELORA_AI_GENERATION_PENDING_TIMEOUT_SECONDS=120

# Optional direct Etsy listing-edit integration for published Etsy products.
# VELORA_ETSY_SHOP_ID is only a fallback when a store connection does not yet have a saved etsy_shop_id.
VELORA_ETSY_API_KEYSTRING=replace-me
VELORA_ETSY_SHARED_SECRET=replace-me
VELORA_ETSY_OAUTH_REDIRECT_URI=https://replace-me.example/settings/etsy/callback
VELORA_ETSY_REFRESH_TOKEN=replace-me
VELORA_ETSY_SHOP_ID=replace-me
VELORA_ETSY_MAX_REQUESTS_PER_SECOND=5
VELORA_ETSY_LEDGER_MAX_CONCURRENCY=4
VELORA_ETSY_MAX_RETRY_ATTEMPTS=2
VELORA_ETSY_MAX_LISTING_IMAGE_BYTES=99614720

# Printify publish is asynchronous. Keep the Velora job active until Printify returns
# the connected storefront listing id.
VELORA_PRINTIFY_POLL_INITIAL_DELAY_SECONDS=5
VELORA_PRINTIFY_POLL_MAX_DELAY_SECONDS=20
VELORA_PRINTIFY_POLL_TIMEOUT_SECONDS=900
VELORA_ENVIRONMENT=development
